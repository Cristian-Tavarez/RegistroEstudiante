@page "/"
@page "/estudiantes"
@rendermode InteractiveServer
@using RegistroEstudiante.Models
@using RegistroEstudiante.Services
@inject EstudiantesService service
@inject NavigationManager nav

<h3 class="mb-4">Registro de Estudiantes</h3>

<div class="card shadow-sm">
    <div class="card-body">

        
        <div class="d-flex justify-content-between mb-3">
            <div class="w-50">
                <input class="form-control"
                       placeholder="Buscar por nombre o matrícula"
                       @bind="filtro" />
            </div>

            <button class="btn btn-primary" @onclick="Crear">
                Crear
            </button>

            @code {
                void Crear()
                {
                    nav.NavigateTo("/estudiantes/create");
                }
            }

        </div>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Matrícula</th>
                    <th>Carrera</th>
                    <th class="text-center">Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in estudiantesFiltrados)
                {
                    <tr>
                        <td>@e.EstudianteId</td>
                        <td>@($"{e.Nombres} {e.Apellidos}")</td>
                        <td>@e.Matricula</td>
                        <td>@e.Carrera</td>
                        <td class="text-center">
                        <td class="text-center">
                            <a class="btn btn-outline-primary btn-sm me-1"
                               href="/estudiantes/edit/@e.EstudianteId">
                                ✏️ Editar
                            </a>

                            <a class="btn btn-outline-danger btn-sm"
                               href="/estudiantes/edit/@e.EstudianteId">
                                🗑 Eliminar
                            </a>
                        </td>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        
        <div class="d-flex justify-content-between mt-3">
            <span><strong>Cantidad:</strong> @estudiantesFiltrados.Count()</span>
        </div>

    </div>
</div>

@code {
    private List<Estudiante> estudiantes = new();
    private string filtro = "";

    protected override async Task OnInitializedAsync()
    {
        estudiantes = await service.ListarAsync();
    }

    private IEnumerable<Estudiante> estudiantesFiltrados =>
        estudiantes.Where(e =>
            string.IsNullOrWhiteSpace(filtro) ||
            e.Nombres.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
            e.Matricula.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    private void Editar(int id)
    {
        nav.NavigateTo($"/estudiantes/edit/{id}");
    }

    private async Task Eliminar(int id)
    {
        await service.EliminarAsync(id);
        estudiantes = await service.ListarAsync();
    }
}
