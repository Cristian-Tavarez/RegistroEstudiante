@page "/asignaturas/create"
@rendermode InteractiveServer
@using RegistroEstudiante.Models
@using RegistroEstudiante.Services
@inject AsignaturasService service
@inject NavigationManager nav

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header text-center">
                <h4>Crear Asignatura</h4>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger">@error</div>
                }

                <EditForm Model="@asignatura"
                          OnValidSubmit="Guardar"
                          FormName="crearAsignatura">

                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label">Código</label>
                        <InputText class="form-control"
                                   @bind-Value="asignatura.Codigo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control"
                                   @bind-Value="asignatura.Nombre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Aula</label>
                        <InputText class="form-control"
                                   @bind-Value="asignatura.Aula" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Créditos</label>
                        <InputNumber class="form-control"
                                     @bind-Value="asignatura.Creditos" />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="Volver">
                            ← Volver
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            💾 Guardar
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private Asignatura asignatura = new();
    private string? error;

    private async Task Guardar()
    {
        if (await service.ExisteNombreAsync(asignatura.Nombre))
        {
            error = "Ya existe una asignatura con ese nombre.";
            return;
        }

        await service.GuardarAsync(asignatura);
        nav.NavigateTo("/asignaturas");
    }

    private void Volver()
    {
        nav.NavigateTo("/asignaturas");
    }
}
