@page "/asignaturas/edit/{Id:int}"
@rendermode InteractiveServer
@using RegistroEstudiante.Models
@using RegistroEstudiante.Services
@inject AsignaturasService service
@inject NavigationManager nav

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header text-center">
                <h4>Modificar Asignatura</h4>
            </div>

            <div class="card-body">
                @if (asignatura == null)
                {
                    <p class="text-danger text-center">
                        Asignatura no encontrada
                    </p>
                }
                else
                {
                    <EditForm Model="asignatura"
                              OnValidSubmit="Guardar"
                              FormName="editarAsignatura">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Código</label>
                            <InputText class="form-control"
                                       @bind-Value="asignatura.Codigo" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control"
                                       @bind-Value="asignatura.Nombre" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Aula</label>
                            <InputText class="form-control"
                                       @bind-Value="asignatura.Aula" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Créditos</label>
                            <InputNumber class="form-control"
                                         @bind-Value="asignatura.Creditos" />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="button"
                                    class="btn btn-secondary"
                                    @onclick="Volver">
                                ← Volver
                            </button>

                            <div>
                                <button type="submit"
                                        class="btn btn-primary me-2">
                                    💾 Modificar
                                </button>

                                <button type="button"
                                        class="btn btn-danger"
                                        @onclick="Eliminar">
                                    🗑 Eliminar
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Asignatura? asignatura;

    protected override async Task OnInitializedAsync()
    {
        asignatura = await service.BuscarAsync(Id);
    }

    private async Task Guardar()
    {
        await service.GuardarAsync(asignatura!);
        nav.NavigateTo("/asignaturas");
    }

    private async Task Eliminar()
    {
        await service.EliminarAsync(Id);
        nav.NavigateTo("/asignaturas");
    }

    private void Volver()
    {
        nav.NavigateTo("/asignaturas");
    }
}
