@page "/asignaturas/tipospuntos"
@rendermode InteractiveServer
@using RegistroEstudiante.Models
@using RegistroEstudiante.Services
@inject TiposPuntosService service
@inject NavigationManager nav

<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">🎯 Tipos de Puntos</h4>

                <button class="btn btn-primary"
                        @onclick="Nuevo">
                    ➕ Nuevo
                </button>
            </div>

            <div class="card-body p-0">
                @if (lista == null)
                {
                    <p class="text-center p-3">Cargando...</p>
                }
                else if (!lista.Any())
                {
                    <p class="text-center p-3 text-muted">
                        No hay tipos de puntos registrados
                    </p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Puntos</th>
                                <th>Color</th>
                                <th>Icono</th>
                                <th>Activo</th>
                                <th class="text-center">Opciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var t in lista)
                            {
                                <tr>
                                    <td>@t.Nombre</td>
                                    <td>@t.Descripcion</td>
                                    <td>@t.ValorPuntos</td>
                                    <td>
                                        <span class="badge"
                                              style="background-color:@t.Color">
                                            @t.Color
                                        </span>
                                    </td>
                                    <td>@t.Icono</td>
                                    <td>
                                        @if (t.Activo)
                                        {
                                            <span class="badge bg-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-primary btn-sm me-2"
                                                @onclick="() => Editar(t.TipoId)">
                                            ✏️
                                        </button>

                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => Eliminar(t.TipoId)">
                                            🗑
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="card-footer text-bold text-start">
                Cantidad: @lista?.Count
            </div>

        </div>
    </div>
</div>

@code {
    List<TipoPunto>? lista;

    protected override async Task OnInitializedAsync()
    {
        lista = await service.ListarAsync();
    }

    void Nuevo()
    {
        nav.NavigateTo("/asignaturas/tipospuntos/create");
    }

    void Editar(int id)
    {
        nav.NavigateTo($"/asignaturas/tipospuntos/edit/{id}");
    }

    async Task Eliminar(int id)
    {
        await service.EliminarAsync(id);
        lista = await service.ListarAsync();
    }
}
